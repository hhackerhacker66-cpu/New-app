<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Diamond Glow Shadow -->
    <path
        android:pathData="M34,42 L54,26 L74,42 L54,82 Z"
        android:fillColor="#3300E5FF" />
    
    <!-- Top facets of the Diamond -->
    <path
        android:pathData="M36,44 L44,30 L54,30 L48,44 Z"
        android:fillColor="#80D8FF" />
    <path
        android:pathData="M44,30 L54,30 L64,30 L54,44 Z"
        android:fillColor="#B3E5FC" />
    <path
        android:pathData="M64,30 L72,44 L60,44 Z"
        android:fillColor="#40C4FF" />
    <path
        android:pathData="M36,44 L48,44 L54,44 Z"
        android:fillColor="#00B0FF" />
    <path
        android:pathData="M54,44 L60,44 L72,44 Z"
        android:fillColor="#0091EA" />
    
    <!-- Bottom facets pointing down -->
    <path
        android:pathData="M36,44 L48,44 L54,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="44"
                android:endX="54"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#00B0FF" />
                <item android:offset="1.0" android:color="#01579B" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M48,44 L60,44 L54,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="44"
                android:endX="60"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#80D8FF" />
                <item android:offset="1.0" android:color="#0288D1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M60,44 L72,44 L54,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="60"
                android:startY="44"
                android:endX="54"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#0091EA" />
                <item android:offset="1.0" android:color="#01579B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Highlight sparkle -->
    <path
        android:pathData="M44,34 L45,37 L48,38 L45,39 L44,42 L43,39 L40,38 L43,37 Z"
